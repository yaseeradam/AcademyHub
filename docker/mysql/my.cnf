[mysqld]
# Character set
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Performance tuning for school server (4-8GB RAM)
innodb_buffer_pool_size = 256M
innodb_log_file_size = 64M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT

# Connection limits
max_connections = 150
max_allowed_packet = 64M

# Query cache (useful for repeated score/attendance lookups)
sort_buffer_size = 2M
join_buffer_size = 2M
tmp_table_size = 64M
max_heap_table_size = 64M

# Slow query log
slow_query_log = 1
long_query_time = 2

[client]
default-character-set = utf8mb4
