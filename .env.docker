# =============================================================================
# AcademyHub Docker Environment Variables
# Copy this file to .env before running: docker compose up -d
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=AcademyHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# For local LAN: http://192.168.1.100
# For cloud: https://yourschool.com
APP_URL=http://localhost
APP_PORT=80

# ── Database ─────────────────────────────────────────────────────────────────
DB_DATABASE=academyhub
DB_USERNAME=academyhub
DB_PASSWORD=change_this_password
DB_ROOT_PASSWORD=change_this_root_password
DB_EXTERNAL_PORT=3306

# ── Cache & Sessions ────────────────────────────────────────────────────────
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=database

# ── School Branding ─────────────────────────────────────────────────────────
MYACADEMY_SCHOOL_NAME="Your School Name"
MYACADEMY_ADMIN_EMAIL=admin@school.com
MYACADEMY_ADMIN_PASSWORD=changeme

# ── WhatsApp Integration (optional - leave empty for offline-only) ──────────
WHATSAPP_API_KEY=

# ── AI Teacher Remarks (optional - leave empty for offline-only) ────────────
GROQ_API_KEY=
