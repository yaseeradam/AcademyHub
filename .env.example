APP_NAME=AcademyHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
ASSET_URL=/

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=academyhub
DB_USERNAME=academyhub_user
DB_PASSWORD=

ACADEMYHUB_ADMIN_EMAIL=admin@yourdomain.com
ACADEMYHUB_ADMIN_PASSWORD=change_this_password

# WhatsApp Bot shared secret (required for /api/whatsapp/* endpoints)
WHATSAPP_API_KEY=

# CORS allowed origins (comma-separated, defaults to APP_URL)
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com

GROQ_API_KEY=

# School branding
ACADEMYHUB_SCHOOL_NAME="Your School Name"
ACADEMYHUB_SCHOOL_TAGLINE="Excellence in Education"

# Optional: MySQL CLI paths (Linux)
# ACADEMYHUB_MYSQLDUMP=/usr/bin/mysqldump
# ACADEMYHUB_MYSQL=/usr/bin/mysql

BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
# Local HTTP: set false. Production HTTPS: set true.
SESSION_SECURE_COOKIE=false
# IMPORTANT: For multi-school tenant isolation, leave SESSION_DOMAIN empty!
SESSION_DOMAIN=

MEMCACHED_HOST=127.0.0.1

# Redis Database Partitioning (prevents cache clears from wiping sessions or queues)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2

# Laravel Reverb WebSockets
REVERB_APP_ID=academyhub
REVERB_APP_KEY=academyhub-reverb-key
REVERB_APP_SECRET=academyhub-reverb-secret
REVERB_HOST=yourdomain.com
REVERB_PORT=8080
REVERB_SCHEME=https

# Frontend Vite variables
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Browsershot (certificate PDF generation)
# If Node/NPM/Chrome are not in PATH on your server, set these:
# BROWSERSHOT_NODE_BINARY=/usr/bin/node
# BROWSERSHOT_NPM_BINARY=/usr/bin/npm
# BROWSERSHOT_CHROME_PATH=/usr/bin/google-chrome

# Optional demo seed (local/dev only)
# ACADEMYHUB_SEED_DEMO_TENANT=true
# ACADEMYHUB_DEMO_TENANT_NAME="Demo School"
# ACADEMYHUB_DEMO_TENANT_SLUG=demo
# ACADEMYHUB_DEMO_TENANT_DOMAIN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
