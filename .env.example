APP_NAME=MyAcademy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myacademy
DB_USERNAME=myacademy_user
DB_PASSWORD=

MYACADEMY_ADMIN_EMAIL=admin@yourdomain.com
MYACADEMY_ADMIN_PASSWORD=change_this_password

GROQ_API_KEY=
GEMINI_API_KEY=

# School branding
MYACADEMY_SCHOOL_NAME="Your School Name"
MYACADEMY_SCHOOL_TAGLINE="Excellence in Education"

# Optional: MySQL CLI paths (Linux)
# MYACADEMY_MYSQLDUMP=/usr/bin/mysqldump
# MYACADEMY_MYSQL=/usr/bin/mysql

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Local HTTP: set false. Production HTTPS: set true.
SESSION_SECURE_COOKIE=false
# For multi-school subdomains in production, set this (example):
# SESSION_DOMAIN=.yourdomain.com

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Browsershot (certificate PDF generation)
# If Node/NPM/Chrome are not in PATH on your server, set these:
# BROWSERSHOT_NODE_BINARY=/usr/bin/node
# BROWSERSHOT_NPM_BINARY=/usr/bin/npm
# BROWSERSHOT_CHROME_PATH=/usr/bin/google-chrome

# Optional demo seed (local/dev only)
# MYACADEMY_SEED_DEMO_TENANT=true
# MYACADEMY_DEMO_TENANT_NAME="Demo School"
# MYACADEMY_DEMO_TENANT_SLUG=demo
# MYACADEMY_DEMO_TENANT_DOMAIN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
